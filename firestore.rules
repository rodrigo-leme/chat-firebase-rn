rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    function directId(a, b) {
      return a < b ? 'direct_' + a + '_' + b : 'direct_' + b + '_' + a;
    }

    // Compartilha conversa individual OU grupo (profileAccess é mantido pela API).
    function sharesConversation(uid) {
      return exists(/databases/$(database)/documents/directConversations/$(directId(request.auth.uid, uid)))
        || (exists(/databases/$(database)/documents/profileAccess/$(uid + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/profileAccess/$(uid + '_' + request.auth.uid)).data.groupIds.size() > 0);
    }

    // ---------- Perfil completo (dados cadastrais) ----------
    match /users/{uid} {
      allow read: if isMe(uid) || (signedIn() && sharesConversation(uid));
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['uid','name','email','phoneNumber','birthDate','photoUrl','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phoneNumber','birthDate','photoUrl']);
      allow delete: if false;

      // Tokens de dispositivo: somente o próprio usuário (a API usa Admin SDK).
      match /devices/{deviceId} {
        allow read, write: if isMe(uid);
      }
    }

    // ---------- Perfil público (nome + foto) para a lista de usuários ----------
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['uid','name','photoUrl'])
        && request.resource.data.uid == uid;
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoUrl']);
      allow delete: if false;
    }

    // ---------- Conversas individuais ----------
    match /directConversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participantIds','createdAt'])
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && conversationId == directId(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1]));
      allow update, delete: if false;
    }

    // ---------- Grupos ----------
    function validGroup(data) {
      return data.keys().hasOnly(['name','photoUrl','ownerId','memberIds','memberLimit','notificationPolicy','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.photoUrl is string
        && data.memberLimit is int && data.memberLimit >= 2 && data.memberLimit <= 50
        && data.memberIds is list
        && data.memberIds.size() >= 2
        // Limite garantido no servidor: avaliado sobre o documento resultante de cada escrita.
        && data.memberIds.size() <= data.memberLimit
        && data.memberIds.hasAll([data.ownerId])
        && data.notificationPolicy in ['all_group_messages','mentioned_members','direct_messages_only','disabled'];
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validGroup(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validGroup(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- Somente a API (Admin SDK) ----------
    match /profileAccess/{id} { allow read, write: if false; }
    match /notificationDispatches/{id} { allow read, write: if false; }
  }
}
